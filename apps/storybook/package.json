    "dev": "pnpm run build:federated-widget && wait-on ../../packages/icons/dist/index.d.ts ../../packages/proteus/dist/index.d.ts ../../packages/react/dist/index.d.ts ../../packages/react/dist/unstable.d.ts ../../packages/shared/data/docs.json && storybook dev -p 6006",
    "test": "vitest"
  },
  "devDependencies": {
