    "@radix-ui/react-visually-hidden": "1.2.12",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "chromatic": "^18.14.3",
    "raw-loader": "^4.0.2",
    "react": "^18.3.1",
    "react-docgen": "^8.0.4",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.7",
    "storybook-addon-test-codegen": "^3.0.4",
